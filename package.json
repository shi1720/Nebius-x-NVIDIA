{
  "name": "recallroom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --config vite.firebase.config.ts",
    "build": "npm run build:api && npm run build:web",
    "start": "next start",
    "lint": "eslint app components/recall-room.tsx components/lot-graph.tsx lib tests db/schema.ts --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components/recall-room.tsx components/lot-graph.tsx lib db/schema.ts tests docs README.md",
    "test:api": "node scripts/test-api.mjs",
    "test:live": "tsx scripts/test-live.ts",
    "test:quota": "python3 scripts/test-quota.py",
    "db:local": "node scripts/migrate-local.mjs",
    "samples": "tsx scripts/generate-samples.ts && python3 scripts/package-samples.py",
    "dev:api": "next dev --port 3000",
    "build:api": "next build --webpack",
    "build:web": "vite build --config vite.firebase.config.ts",
    "deploy": "bash scripts/deploy-firebase.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google-cloud/tasks": "^7.1.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "5.4.149",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.131.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
